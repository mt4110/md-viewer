{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-viewer",
  "version": "0.1.1",
  "identifier": "io.github.mt4110.mdviewer",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [{ "title": "md-viewer", "width": 1080, "height": 780, "minWidth": 420, "minHeight": 360 }],
    "security": { "csp": "default-src 'self'; img-src data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "resources": {
      "LICENSE": "LICENSE.txt",
      "resources/notices/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "resources/notices/THIRD_PARTY_NOTICES.json": "THIRD_PARTY_NOTICES.json"
    },
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["md", "markdown"], "name": "Markdown", "role": "Viewer" }],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" }, "nsis": { "languages": ["Japanese"], "installMode": "currentUser" } }
  }
}
